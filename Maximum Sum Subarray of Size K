class Solution {
    public int maxSubarraySum(int[] arr, int k) {
    
        int n=arr.length;
        int sum=0;
        for(int i=0;i<k;i++){
            sum=sum+arr[i];
        }
        int max=sum;
        for(int i=k;i<n;i++){
            sum=sum-arr[i-k];
            sum=sum+arr[i];
            max=Math.max(max,sum);
        }
        return max;
    }
}
