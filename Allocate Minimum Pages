class Solution {
    public int findPages(int[] arr, int k) {
       int n=arr.length;
       if(n<k) return -1;
       int low=0;
       int high=0;
       int res=-1;
       for(int i=0;i<n;i++){
           low=Math.max(low,arr[i]);
           high=high+arr[i];
       }
       while(low<=high){
           int guess=low+(high-low)/2;
           if(books(books,n,guess,k)){
               res=guess;
               high=guess-1;
           }else
           {
               low=guess+1;
           }
       
       
       }
       return res;
    }
    public boolean books(int[]books,int n,int limit,int stud){
        int k=1;
        int page=0;
        for(int i=0;i<n;i++){
            if(page+books[i]<=limit){
                page=page+books[i];
            }else{
                k++;
                page=books[i];
                if(k>stud) return false;
            }
        }
        return true;
    }
}
