class Solution {
    public int findKRotation(int arr[]) {
        int n = arr.length;
        int ans = -1;

        int low = 0;
        int high = n - 1;

        while (low <= high) {
            int guess = low + (high - low) / 2;

            if (arr[guess] > arr[n - 1]) {
                low = guess + 1;
            } else {
                ans = guess;
                high = guess - 1;
            }
        }

        return ans;
    }
}
