

class Solution {
    static int minCostClimbingStairs(int[] cost) {
        int n=cost.length;
        
        if(n<=1) return 1;
       
        for(int i=2;i<n;i++){
           int curr=Math.min(cost[i-1],cost[i-2]);
        
        
        cost[i]=cost[i]+curr;
        }
        return Math.min(cost[n-1], cost[n-2]);
    }
}
