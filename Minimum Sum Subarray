class Solution {
    static int smallestSumSubarray(int nums[], int size) {
       int i=0;
     size=nums[0];
     int ans=nums[0];
     for(i=1;i<nums.length;i++){
        int b1=size+nums[i];
        int b2=nums[i];
        size=Math.min(b1,b2);
        ans=Math.min(size,ans);
     }
     return ans;
        
    }
}
