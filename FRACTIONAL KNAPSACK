class Solution {
    public double fractionalKnapsack(int[] val, int[] wt, int capacity) {
       int n=val.length;
       Integer[]index=new Integer[n];
       for(int i=0;i<n;i++){
           index[i]=i;
       }
       Arrays.sort(index,(a,b)->Double.compare((double)val[b]/wt[b],(double)val[a]/wt[a]));
       double profit=0.0;
       for(int i=0;i<n;i++){
           int idx=index[i];
                   if (wt[idx] <= capacity) {
                profit += val[idx];
                capacity -= wt[idx];
            } else {
                profit += ((double) val[idx] / wt[idx]) * capacity;
                break;
            }
        }

        return profit;
    }
}
