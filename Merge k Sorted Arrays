class Solution {
    public ArrayList<Integer> mergeArrays(int[][] mat) {
       class Pair {
           int value;
           int row;
           int column;

           Pair(int v, int r, int c) {
               value = v;
               row = r;
               column = c;
           }
       }
       PriorityQueue<Pair> pq = new PriorityQueue<>((a, b) -> {
           if (a.value != b.value)
               return a.value - b.value;
           return 0;
       });
       
        ArrayList<Integer> ans = new ArrayList<>();
        int n = mat.length;
        int m = mat[0].length;
        for (int i = 0; i < n; i++) {
            pq.add(new Pair(mat[i][0], i, 0));
        }
        while (!pq.isEmpty()) {

            Pair p = pq.poll();

            ans.add(p.value);

            int row = p.row;
            int column = p.column;

            if (column == m - 1)
                continue;

            pq.add(new Pair(
                mat[row][column + 1],
                row,
                column + 1
            ));
        }

        return ans;
        
    }
}
